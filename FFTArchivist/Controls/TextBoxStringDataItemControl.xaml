<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:DataItems="clr-namespace:FFTArchivist.ViewModels.DataItems"
             x:Class="FFTArchivist.Controls.TextBoxStringDataItemControl"
             mc:Ignorable="d"
             d:DesignHeight="30" d:DesignWidth="800">
    <UserControl.DataContext>
        <DataItems:TextBoxStringDataItemViewModel x:Name="DataItemViewModel"/>
    </UserControl.DataContext>
    <DockPanel>
        <Label x:Name="FieldLabel" Content="{Binding Path=Label}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <Button x:Name="RevertButton" DockPanel.Dock="Right" VerticalContentAlignment="Center" Margin="5,4,5,4" MinHeight="18" MinWidth="18"
                    Visibility="{Binding DataItem.IsModified, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"
                    Click="RevertButton_Click">
            <Image Source="{Binding Mode=OneWay, Source={StaticResource HistoryIcon}}" Width="16" Height="16"/>
        </Button>
        <TextBox x:Name="FieldText" DockPanel.Dock="Left" VerticalAlignment="Center"
                 Text="{Binding Path=Value, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{Binding Path=OriginalValue, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Setter Property="Background" Value="{StaticResource TextBoxBackgroundBrush}"></Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=DataItem.IsModified}" Value="True">
                            <Setter Property="Background" Value="{StaticResource TextBoxModifiedBackgroundBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>
    </DockPanel>
</UserControl>
