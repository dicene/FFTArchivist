<Window x:Class="FFTArchivist.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FFTArchivist"
        mc:Ignorable="d"
        Title="FFT Archivist" Height="450" Width="800" Loaded="Window_Loaded" Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <!--<RowDefinition Height="30" />-->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--<StackPanel Orientation="Vertical">-->
            <!--<StackPanel Orientation="Horizontal">
                <Button x:Name="ModDetailsButton" Content="Load Data" Click="ModDetailsButton_Click" Margin="5"/>
            </StackPanel>-->
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ImportModButton" Content="Import Mod" Click="ImportModButton_Click" Margin="5"/>
                <Button x:Name="ExportModButton" Content="Export Mod" Click="ExportModButton_Click" Margin="5"/>
            </StackPanel>
        <!--</StackPanel>-->
        <WrapPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0">
            
        </WrapPanel>
        <DockPanel Grid.Row="0" Grid.Column="1">
            <Button x:Name="ItemEditorButton" Content="Items" Click="ItemEditorButton_Click" Margin="3,5,3,5" DockPanel.Dock="Left"/>
            <Button x:Name="AbilityEditorButton" Content="Abilities" Click="AbilityEditorButton_Click" Margin="3,5,3,5" DockPanel.Dock="Left"/>
            <Button x:Name="JobEditorButton" Content="Jobs" Click="JobEditorButton_Click" Margin="3,5,3,5" DockPanel.Dock="Left" Visibility="Collapsed"/>
            <Button x:Name="PoachEditorButton" Content="Poach" Click="PoachEditorButton_Click" Margin="3,5,3,5" DockPanel.Dock="Left"/>
            <Button x:Name="Settings" Content="Settings" Click="SettingsEditorButton_Click" Margin="3,5,3,5" DockPanel.Dock="Right"/>
            <Label Content="" DockPanel.Dock="Right"/>
        </DockPanel>        
        <ListBox x:Name="EntryListBox" Grid.Row="1" Grid.Column="0" SelectionChanged="EntryListBox_SelectionChanged" Margin="5,0,5,0"/>
        <GridSplitter Grid.Row="1" Grid.Column="0" Width="5" HorizontalAlignment="Right" Background="{DynamicResource ButtonBackgroundBrush}" Margin="0"/>
        <Border Grid.Row="1" Grid.Column="1" Margin="5">
            <Frame x:Name="EditorFrame" NavigationUIVisibility="Hidden" Source="/Views/ItemView.xaml"/>
        </Border>
    </Grid>
</Window>
