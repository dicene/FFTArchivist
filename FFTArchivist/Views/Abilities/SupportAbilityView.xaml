<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FFTArchivist.Views.Abilities"
      xmlns:Entries="clr-namespace:FFTArchivist.Entries" x:Class="FFTArchivist.Views.Abilities.SupportAbilityView"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SupportAbility">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.DataContext>
            <Entries:SupportAbilityViewModel/>
        </Grid.DataContext>
        <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,10,0">
            <Label Content="Reaction/Support/Movement" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="32"/>
        </DockPanel>
        <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,10,0">
            <Label Content="Ability:" VerticalAlignment="Center" />
            <TextBox x:Name="AbilityId" VerticalAlignment="Center" Text="{Binding AbilityId}" Background="{DynamicResource TextBoxBackgroundBrush}"/>
            <!--<ComboBox x:Name="AbilityId" VerticalAlignment="Center" ItemsSource="{Binding AbilityNames, Mode=OneWay, NotifyOnSourceUpdated=True}" SelectedIndex="{Binding AbilityID}" Background="{DynamicResource TextBoxBackgroundBrush}"/>-->
        </DockPanel>
    </Grid>
</Page>
