<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FFTArchivist"
      xmlns:Pages="clr-namespace:FFTArchivist.ViewModels.Pages" x:Class="FFTArchivist.UIView"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UIView" Background="{DynamicResource WindowBackgroundBrush}">

    <Page.DataContext>
        <Pages:UIViewModel x:Name="UIViewModel"/>
    </Page.DataContext>

    <DockPanel LastChildFill="True" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0,0,10,0">
        <!--<.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </.ColumnDefinitions>
        <.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
        </.RowDefinitions>-->
        <TextBlock DockPanel.Dock="Top" Text="UI" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="26" Grid.Row="0" Grid.Column="0" FontFamily="Sitka Text" Margin="5,0,0,0" />
        <DockPanel DockPanel.Dock="Top" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,10,0">
            <Label Content="Unknown 0:" VerticalAlignment="Center" />
            <TextBox x:Name="Unknown0" VerticalAlignment="Center" Text="{Binding Unknown0}" />
        </DockPanel>
        <DockPanel DockPanel.Dock="Top" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0,0,10,0">
            <Label Content="Text:"  />
            <TextBox x:Name="Text"  Text="{Binding Text}" TextWrapping="Wrap" AcceptsReturn="True" SpellCheck.IsEnabled="True" AcceptsTab="True" MinLines="5" Margin="5"/>
        </DockPanel>
    </DockPanel>
</Page>
