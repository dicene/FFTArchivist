<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FFTArchivist"
      xmlns:Entries="clr-namespace:FFTArchivist.Entries" x:Class="FFTArchivist.PoachView"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PoachView" Background="{DynamicResource WindowBackgroundBrush}">

    <Page.DataContext>
        <Entries:PoachViewModel x:Name="PoachViewModel"/>
    </Page.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Poach" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="26" Grid.Row="0" Grid.Column="0" FontFamily="Sitka Text" Margin="5,0,0,0">
            <!--<TextBlock.BitmapEffect>
                <OuterGlowBitmapEffect GlowColor="Black" GlowSize="5" Opacity=""/>
            </TextBlock.BitmapEffect>-->
        </TextBlock>
        <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,10,0">
            <Label Content="Name:" VerticalAlignment="Center" />
            <TextBox x:Name="Name" VerticalAlignment="Center" Text="{Binding Name}" />
        </DockPanel>
        <DockPanel Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,10,0">
            <Label Content="Reward:" VerticalAlignment="Center" />
            <ComboBox x:Name="Reward" VerticalAlignment="Center" ItemsSource="{Binding ItemNames, Mode=OneWay, NotifyOnSourceUpdated=True}" SelectedIndex="{Binding ItemID}" Background="{DynamicResource TextBoxBackgroundBrush}">
            </ComboBox>
        </DockPanel>
        <DockPanel Grid.Row="2" Grid.RowSpan="4" Grid.Column="0" Grid.ColumnSpan="6" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0,0,10,0">
            <Label Content="Description:" VerticalAlignment="Top" />
            <TextBox x:Name="Description" VerticalAlignment="Center" Text="{Binding Description}" TextWrapping="Wrap" AcceptsReturn="True" SpellCheck.IsEnabled="True" AcceptsTab="True" MinLines="5" Margin="5"/>
        </DockPanel>
    </Grid>
</Page>
