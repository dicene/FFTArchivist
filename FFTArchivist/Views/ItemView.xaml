<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FFTArchivist"
      xmlns:Pages="clr-namespace:FFTArchivist.ViewModels.Pages"
      xmlns:TextBoxControls="clr-namespace:FFTArchivist.Controls.TextBox"
      x:Class="FFTArchivist.ItemView"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ItemView" Background="{DynamicResource WindowBackgroundBrush}">

    <Page.DataContext>
        <Pages:ItemPageViewModel x:Name="ItemPageViewModel"/>
    </Page.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Items" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="26" Grid.Row="0" Grid.Column="0" FontFamily="Sitka Text" Margin="5,0,0,0">
        </TextBlock>
        <TextBoxControls:TextBoxStringDataItemControl Label="Name:" MaxLength="50" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center" x:Name="NameControl" DataContext="{Binding NameDataItemViewModel}"/>
        <TextBoxControls:TextBoxIntDataItemControl Label="Price:" MaxLength="123" DisplayAsHex="True" Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" VerticalAlignment="Center" x:Name="PriceControl" DataContext="{Binding PriceDataItemViewModel}"/>
        <DockPanel Grid.Row="2" Grid.RowSpan="4" Grid.Column="0" Grid.ColumnSpan="6" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0,0,10,0">
            <Label Content="Description:" VerticalAlignment="Top" DockPanel.Dock="Top"/>
            <TextBox x:Name="Description" VerticalAlignment="Center" Text="{Binding DescriptionDataItemViewModel.Value}" TextWrapping="Wrap" AcceptsReturn="True" SpellCheck.IsEnabled="True" AcceptsTab="True" MinLines="5" Margin="0" DockPanel.Dock="Top"/>
        </DockPanel>
    </Grid>
</Page>
